# =============================================================================
# .gitignore for Aldur - Binary security analyzer
# =============================================================================
.venv/
site/

# =============================================================================
# Rust / Cargo
# =============================================================================
# Build output directory
/src/target/
target/

# Cargo.lock is tracked - this is a binary application
# (For library crates, Cargo.lock would typically be ignored)

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows debugger info
*.pdb

# =============================================================================
# Code Coverage & Testing
# =============================================================================
# Tarpaulin coverage output
tarpaulin-report.html
tarpaulin-report.json
cobertura.xml
lcov.info

# llvm-cov / grcov output
coverage/
*.profraw
*.profdata

# Test output
*.out

# =============================================================================
# IDEs and Editors
# =============================================================================
# JetBrains IDEs (RustRover, CLion, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim/Neovim
*.swp
*.swo
*~
.netrwhist
Session.vim
.undodir/

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp

# =============================================================================
# Operating System Files
# =============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# =============================================================================
# Miscellaneous
# =============================================================================
# Crash dumps
core
core.*

# Profiling
*.prof
perf.data
perf.data.old

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.orig

# Local environment files
.envrc
.env
.env.local
.env.*.local

# Secrets (never commit these!)
*.pem
*.key

# =============================================================================
# Project-specific
# =============================================================================
# Accidentally created directory (from cargo --version output)
/src/cargo*/
